 #include <tinyalsa/asoundlib.h>
@@ -734,6 +736,42 @@ static bool write_pipe_bounded(int fd, const char * p, size_t remaining, size_t
     return true;
 }
 
+/* Level meter tap (level_meter.h): how long after a write returns its last
+ * frame is heard, so the meter can move with the sound.
+ *
+ * Local output is exact: writes block on a full ALSA buffer, so the frame
+ * just written sits one buffer length from the DAC. The pipe targets are an
+ * estimate: what is still waiting in the pipe is read from the kernel, aplay
+ * keeps its own buffer full behind that (its default, half a second), and a
+ * Bluetooth link adds about a quarter of a second of its own, which is what
+ * BlueALSA reports for the A2DP links tried. A meter that is 50 ms out is not
+ * seen; one that is a second early is. */
+#define METER_APLAY_BUFFER_MS 500
+#define METER_BT_LINK_MS 250
+
+static unsigned meter_latency_ms(int pipe_fd, size_t frame_bytes) {
+    unsigned rate = device_sample_rate ? device_sample_rate : 44100;
+    if (pipe_fd < 0)
+        return alsa_pcm ? (unsigned) ((uint64_t) pcm_get_buffer_size(alsa_pcm) * 1000u / rate) : 0;
+    int waiting = 0;
+    if (ioctl(pipe_fd, FIONREAD, &waiting) != 0 || waiting < 0) waiting = 0;
+    unsigned ms = (unsigned) ((uint64_t) waiting * 1000u / (rate * frame_bytes)) + METER_APLAY_BUFFER_MS;
+    return active_target == OUTPUT_TARGET_BT ? ms + METER_BT_LINK_MS : ms;
+}
+
+static void meter_feed_s16(const int16_t * buf, uint64_t frames, unsigned int channels, int pipe_fd) {
+    if (!level_meter_wanted()) return;
+    level_meter_feed_s16(buf, (size_t) frames, channels, device_sample_rate,
+                         meter_latency_ms(pipe_fd, channels * sizeof(int16_t)));
+}
+
+/* DoP frames are DSD bits under a marker byte, not samples: no level to read. */
+static void meter_feed_s24(const int32_t * buf, uint64_t frames, unsigned int channels, int pipe_fd) {
+    if (active_dop || !level_meter_wanted()) return;
+    level_meter_feed_s24(buf, (size_t) frames, channels, device_sample_rate,
+                         meter_latency_ms(pipe_fd, channels * sizeof(int32_t)));
+}
+
 bool audio_output_write(const int16_t * buf, uint64_t frames, unsigned int channels, uint64_t * out_frames_written) {
     if (out_frames_written) *out_frames_written = 0;
     if (!caller_owns_output()) return false;
@@ -796,6 +834,7 @@ bool audio_output_write(const int16_t * buf, uint64_t frames, unsigned int chann
             }
             return false;
         }
+        meter_feed_s16(buf, frames, channels, fd);
         if (out_frames_written) *out_frames_written = frames;
         return true;
     }
@@ -813,6 +852,7 @@ bool audio_output_write(const int16_t * buf, uint64_t frames, unsigned int chann
                     ret < 0 ? pcm_get_error(alsa_pcm) : "short write");
             return false;
         }
+        meter_feed_s16(buf, frames, channels, -1);
         if (out_frames_written) *out_frames_written = frames;
         return true;
     }
@@ -874,6 +914,7 @@ bool audio_output_write_s24(const int32_t * buf, uint64_t frames, unsigned int c
             }
             return false;
         }
+        meter_feed_s24(buf, frames, channels, fd);
         if (out_frames_written) *out_frames_written = frames;
         return true;
     }
@@ -891,6 +932,7 @@ bool audio_output_write_s24(const int32_t * buf, uint64_t frames, unsigned int c
                     ret < 0 ? pcm_get_error(alsa_pcm) : "short write");
             return false;
         }
+        meter_feed_s24(buf, frames, channels, -1);
         if (out_frames_written) *out_frames_written = frames;
         return true;
     }
diff --git a/src/audio/visualization/level_meter.c b/src/audio/visualization/level_meter.c
new file mode 100644
index 0000000..baea8e6
--- /dev/null
+++ b/src/audio/visualization/level_meter.c
@@ -0,0 +1,201 @@
+#include "level_meter.h"
+
+#include <math.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <time.h>
+
+/* One block is about 10 ms of sound: short enough that a 50 ms UI tick sees
+ * several, long enough that the ring spans the deepest output path (a pipe
+ * into aplay into a Bluetooth link, about a second) with room to spare. */
+#define BLOCK_MS 10
+#define RING_BLOCKS 256 /* power of two; 2.5 s of blocks */
+#define REQUEST_HOLD_MS 1000
+
+/* Above 48 kHz every Nth frame is measured. The meter shows loudness, and a
+ * 192 kHz stream does not need 384000 multiplies a second to say how loud. */
+#define FULL_RATE_LIMIT 48000
+
+typedef struct {
+    uint32_t due_ms;     /* monotonic ms at which the block's last frame is heard */
+    uint32_t peak[2];    /* largest |sample|, 16-bit scale */
+    uint32_t mean_sq[2]; /* mean of sample^2, 16-bit scale (fits: 32768^2 = 2^30) */
+    float band_sq[LEVEL_METER_BANDS]; /* mean of the band-passed mono mix squared, 0..1 */
+} level_block_t;
+
+const float level_meter_band_hz[LEVEL_METER_BANDS] = {
+    31.25f, 62.5f, 125.0f, 250.0f, 500.0f, 1000.0f, 2000.0f, 4000.0f, 8000.0f, 16000.0f,
+};
+
+/* One band-pass per band (RBJ, unity gain at the centre, an octave wide), in
+ * transposed direct form II. Touched by the feeding thread only. */
+#define BAND_Q 1.414f
+typedef struct {
+    float b0, a1, a2; /* b1 is 0 and b2 is -b0 */
+    float z1, z2;
+    bool live;        /* false when the centre is too close to Nyquist */
+} band_filter_t;
+static band_filter_t bands[LEVEL_METER_BANDS];
+static unsigned bands_rate; /* the filtered rate the coefficients are for */
+
+static void bands_design(unsigned rate) {
+    for (int i = 0; i < LEVEL_METER_BANDS; i++) {
+        band_filter_t * f = &bands[i];
+        memset(f, 0, sizeof(*f));
+        if (level_meter_band_hz[i] > 0.45f * (float) rate) continue;
+        float w0 = 2.0f * 3.14159265f * level_meter_band_hz[i] / (float) rate;
+        float alpha = sinf(w0) / (2.0f * BAND_Q);
+        float a0 = 1.0f + alpha;
+        f->b0 = alpha / a0;
+        f->a1 = -2.0f * cosf(w0) / a0;
+        f->a2 = (1.0f - alpha) / a0;
+        f->live = true;
+    }
+    bands_rate = rate;
+}
+
+static level_block_t ring[RING_BLOCKS];
+/* head is written by the feeder only, tail by the reader only. */
+static atomic_uint ring_head;
+static atomic_uint ring_tail;
+static atomic_uint wanted_until_ms;
+static atomic_uint spectrum_until_ms;
+static atomic_bool wanted_ever;
+
+static uint32_t now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint32_t) ((uint64_t) ts.tv_sec * 1000u + (uint64_t) ts.tv_nsec / 1000000u);
+}
+
+void level_meter_request(bool spectrum) {
+    uint32_t until = now_ms() + REQUEST_HOLD_MS;
+    atomic_store_explicit(&wanted_until_ms, until, memory_order_relaxed);
+    if (spectrum) atomic_store_explicit(&spectrum_until_ms, until, memory_order_relaxed);
+    atomic_store_explicit(&wanted_ever, true, memory_order_relaxed);
+}
+
+static bool spectrum_wanted(void) {
+    return (int32_t) (atomic_load_explicit(&spectrum_until_ms, memory_order_relaxed) - now_ms()) > 0;
+}
+
+bool level_meter_wanted(void) {
+    if (!atomic_load_explicit(&wanted_ever, memory_order_relaxed)) return false;
+    /* Signed difference, so the comparison survives the counter wrapping. */
+    return (int32_t) (atomic_load_explicit(&wanted_until_ms, memory_order_relaxed) - now_ms()) > 0;
+}
+
+static void push_block(const level_block_t * block) {
+    unsigned head = atomic_load_explicit(&ring_head, memory_order_relaxed);
+    unsigned tail = atomic_load_explicit(&ring_tail, memory_order_acquire);
+    /* Full: the reader stopped reading. Drop the new block rather than move
+     * the reader's index from this thread. */
+    if (head - tail >= RING_BLOCKS) return;
+    ring[head & (RING_BLOCKS - 1)] = *block;
+    atomic_store_explicit(&ring_head, head + 1, memory_order_release);
+}
+
+/* shift brings a sample to the 16-bit scale: 0 for S16, 8 for S24. */
+#define FEED_BODY(sample_t, shift)                                                         \
+    if (!buf || !frames || !channels || !sample_rate) return;                              \
+    unsigned stride = sample_rate > FULL_RATE_LIMIT ? (sample_rate + 22050) / 44100 : 1;   \
+    size_t block_frames = (size_t) sample_rate * BLOCK_MS / 1000;                          \
+    if (block_frames < stride) block_frames = stride;                                      \
+    unsigned right = channels > 1 ? 1 : 0;                                                 \
+    uint32_t end_ms = now_ms() + latency_ms;                                               \
+    bool spectrum = spectrum_wanted();                                                     \
+    if (spectrum && bands_rate != sample_rate / stride) bands_design(sample_rate / stride); \
+    for (size_t start = 0; start < frames; start += block_frames) {                        \
+        size_t stop = start + block_frames < frames ? start + block_frames : frames;       \
+        uint32_t peak_l = 0, peak_r = 0, count = 0;                                        \
+        uint64_t sum_l = 0, sum_r = 0;                                                     \
+        float band_sum[LEVEL_METER_BANDS] = { 0 };                                         \
+        for (size_t f = start; f < stop; f += stride) {                                    \
+            const sample_t * frame = buf + f * channels;                                   \
+            int32_t l = (int32_t) frame[0] >> (shift);                                     \
+            int32_t r = (int32_t) frame[right] >> (shift);                                 \
+            uint32_t al = (uint32_t) (l < 0 ? -l : l);                                     \
+            uint32_t ar = (uint32_t) (r < 0 ? -r : r);                                     \
+            /* A word wider than its format claims must not overflow the sum. */           \
+            if (al > 32768u) al = 32768u;                                                  \
+            if (ar > 32768u) ar = 32768u;                                                  \
+            if (al > peak_l) peak_l = al;                                                  \
+            if (ar > peak_r) peak_r = ar;                                                  \
+            sum_l += (uint64_t) al * al;                                                   \
+            sum_r += (uint64_t) ar * ar;                                                   \
+            count++;                                                                       \
+            if (spectrum) {                                                                \
+                float x = (float) (l + r) * (1.0f / 65536.0f);                             \
+                for (int b = 0; b < LEVEL_METER_BANDS; b++) {                              \
+                    band_filter_t * bf = &bands[b];                                        \
+                    if (!bf->live) continue;                                               \
+                    float y = bf->b0 * x + bf->z1;                                         \
+                    bf->z1 = bf->z2 - bf->a1 * y;                                          \
+                    bf->z2 = -bf->b0 * x - bf->a2 * y;                                     \
+                    band_sum[b] += y * y;                                                  \
+                }                                                                          \
+            }                                                                              \
+        }                                                                                  \
+        if (!count) continue;                                                              \
+        level_block_t block = {                                                            \
+            .due_ms = end_ms - (uint32_t) ((uint64_t) (frames - stop) * 1000u / sample_rate), \
+            .peak = { peak_l, peak_r },                                                    \
+            .mean_sq = { (uint32_t) (sum_l / count), (uint32_t) (sum_r / count) },         \
+        };                                                                                 \
+        if (spectrum) {                                                                    \
+            for (int b = 0; b < LEVEL_METER_BANDS; b++) {                                  \
+                block.band_sq[b] = band_sum[b] / (float) count;                            \
+                /* A filter ringing down into denormals would cost a kernel trap per      \
+                 * operation on this FPU: stop it at silence instead. */                   \
+                if (fabsf(bands[b].z1) < 1e-15f) bands[b].z1 = 0.0f;                       \
+                if (fabsf(bands[b].z2) < 1e-15f) bands[b].z2 = 0.0f;                       \
+            }                                                                              \
+        }                                                                                  \
+        push_block(&block);                                                                \
+    }
+
+void level_meter_feed_s16(const int16_t * buf, size_t frames, unsigned channels,
+                          unsigned sample_rate, unsigned latency_ms) {
+    FEED_BODY(int16_t, 0)
+}
+
+void level_meter_feed_s24(const int32_t * buf, size_t frames, unsigned channels,
+                          unsigned sample_rate, unsigned latency_ms) {
+    FEED_BODY(int32_t, 8)
+}
+
+bool level_meter_read(level_meter_levels_t * out) {
+    memset(out, 0, sizeof(*out));
+    unsigned tail = atomic_load_explicit(&ring_tail, memory_order_relaxed);
+    unsigned head = atomic_load_explicit(&ring_head, memory_order_acquire);
+    uint32_t now = now_ms();
+
+    uint64_t sum[2] = { 0, 0 };
+    uint32_t peak[2] = { 0, 0 };
+    float band[LEVEL_METER_BANDS] = { 0 };
+    unsigned taken = 0;
+    while (tail != head) {
+        const level_block_t * block = &ring[tail & (RING_BLOCKS - 1)];
+        int32_t late_ms = (int32_t) (now - block->due_ms);
+        if (late_ms < 0) break; /* not heard yet */
+        tail++;
+        /* Heard long ago (the meter was not being read): not what is
+         * sounding now, so it does not count. */
+        if (late_ms > 250) continue;
+        for (int c = 0; c < 2; c++) {
+            sum[c] += block->mean_sq[c];
+            if (block->peak[c] > peak[c]) peak[c] = block->peak[c];
+        }
+        for (int b = 0; b < LEVEL_METER_BANDS; b++) band[b] += block->band_sq[b];
+        taken++;
+    }
+    atomic_store_explicit(&ring_tail, tail, memory_order_release);
+    if (!taken) return false;
+
+    for (int c = 0; c < 2; c++) {
+        out->mean_square[c] = (float) (sum[c] / taken) / (32768.0f * 32768.0f);
+        out->peak[c] = (float) peak[c] / 32768.0f;
+    }
+    for (int b = 0; b < LEVEL_METER_BANDS; b++) out->band_mean_square[b] = band[b] / (float) taken;
+    return true;
+}
diff --git a/src/audio/visualization/level_meter.h b/src/audio/visualization/level_meter.h
new file mode 100644
index 0000000..a623b1b
--- /dev/null
+++ b/src/audio/visualization/level_meter.h
@@ -0,0 +1,59 @@
+#ifndef LEVEL_METER_H
+#define LEVEL_METER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Stereo level tap for the Now Playing level meter (roles vu_left, vu_right,
+ * vu_peak_left, vu_peak_right; see player_vu_meter.h).
+ *
+ * The output owner thread feeds every PCM chunk it has just delivered; the UI
+ * thread reads the levels of the audio that is being heard now. The two meet
+ * in a lock-free single-producer, single-consumer ring of short blocks, each
+ * stamped with the time it leaves the output buffer, so the meter moves with
+ * the sound rather than a buffer's length ahead of it.
+ *
+ * Nothing is measured unless a meter asked within the last second
+ * (level_meter_request()): a layout without a meter, a dark screen or another
+ * screen in front costs the audio thread one atomic load and one clock read
+ * per chunk. */
+
+/* The spectrum: ten bands an octave apart. */
+#define LEVEL_METER_BANDS 10
+extern const float level_meter_band_hz[LEVEL_METER_BANDS]; /* 31.25 Hz ... 16 kHz */
+
+typedef struct {
+    /* Mean square of the samples heard since the previous read, 0..1 against
+     * full scale, per channel. Mono sources report the same value twice. */
+    float mean_square[2];
+    /* Largest absolute sample in the same span, 0..1 against full scale. */
+    float peak[2];
+    /* Mean square of the mono mix in each band over the same span, 0..1.
+     * All zero unless the spectrum was asked for. */
+    float band_mean_square[LEVEL_METER_BANDS];
+} level_meter_levels_t;
+
+/* UI thread: keep the tap measuring for about another second. The spectrum
+ * costs the audio thread ten band-pass filters per sample, so it is only run
+ * while a layout that shows it asks with spectrum = true. */
+void level_meter_request(bool spectrum);
+
+/* Output owner thread: true while a meter is asking. Check before feeding. */
+bool level_meter_wanted(void);
+
+/* Output owner thread: frames just delivered to the output, interleaved.
+ * latency_ms is how long after this call returns the LAST frame is heard.
+ * The s24 form takes samples right-justified in 32 bits (PCM_FORMAT_S24_LE),
+ * as audio_output_write_s24() does. Never feed DSD carrier words. */
+void level_meter_feed_s16(const int16_t * buf, size_t frames, unsigned channels,
+                          unsigned sample_rate, unsigned latency_ms);
+void level_meter_feed_s24(const int32_t * buf, size_t frames, unsigned channels,
+                          unsigned sample_rate, unsigned latency_ms);
+
+/* UI thread: levels of everything that became audible since the last call.
+ * Returns false, with out zeroed, when nothing did (paused, stopped, a
+ * source that is not PCM). */
+bool level_meter_read(level_meter_levels_t * out);
+
+#endif

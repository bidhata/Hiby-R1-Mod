diff --git a/src/ui/player/meter/player_vu_meter.c b/src/ui/player/meter/player_vu_meter.c
new file mode 100644
index 0000000..9fdbe9f
--- /dev/null
+++ b/src/ui/player/meter/player_vu_meter.c
@@ -0,0 +1,293 @@
+#include "player_vu_meter.h"
+
+#include "../../../audio/visualization/level_meter.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#define METER_RANGE 1000   /* bar units from empty to full */
+#define FLOOR_DB (-48.0f)  /* the empty end of the scale */
+/* RMS is shown 3 dB up, the usual convention for a meter that shares a scale
+ * with peaks: a full-scale sine then reads full scale rather than -3. */
+#define RMS_OFFSET_DB 3.0103f
+
+/* A mechanical VU needle takes about 300 ms to settle, the same both ways.
+ * On a decibel scale that fall reads as twitchy, so the bar rises at that
+ * speed and falls more slowly. */
+#define RISE_TAU_MS 60.0f
+#define FALL_TAU_MS 190.0f
+#define PEAK_HOLD_MS 800
+#define PEAK_FALL_PER_MS (1.0f / 1400.0f) /* the whole scale in 1.4 s */
+/* A peak tick is this much of the bar wide. */
+#define PEAK_TICK_UNITS 20
+/* A needle swings this far either side of upright, in tenths of a degree: the
+ * quarter-circle fan of a classic VU dial. Redrawn only when it has moved by
+ * NEEDLE_STEP, since every new angle is a new transformed layer. */
+#define NEEDLE_HALF_SWING 450
+#define NEEDLE_STEP 5
+/* The spectrum bars. A band holds a tenth or so of the programme's energy, so
+ * its scale sits lower than the level's, and it moves faster: it is watched
+ * for rhythm, not read for level. */
+#define BAND_FLOOR_DB (-54.0f)
+#define BAND_TOP_DB 0.0f
+#define BAND_RISE_TAU_MS 35.0f
+#define BAND_FALL_TAU_MS 220.0f
+/* A band's bar is short, so its cap is a larger share of it than a peak tick. */
+#define BAND_CAP_UNITS 36
+/* The tick may not have run for a while (a popup, another screen); the
+ * ballistics then continue as if one long tick had passed, not all of it. */
+#define MAX_STEP_MS 200
+
+static lv_obj_t * level_bar[2]; /* an lv_bar or an lv_arc */
+static lv_obj_t * peak_bar[2];
+static lv_obj_t * needle[2];
+static int32_t needle_drawn[2];
+static bool peak_is_tick[2];
+static lv_obj_t * band_bar[LEVEL_METER_BANDS];
+static lv_obj_t * band_peak[LEVEL_METER_BANDS];
+static bool band_peak_is_tick[LEVEL_METER_BANDS];
+static float band_pos[LEVEL_METER_BANDS];
+static float band_peak_pos[LEVEL_METER_BANDS];
+static int32_t band_hold_ms[LEVEL_METER_BANDS];
+static bool have_bands;
+static float level_pos[2]; /* 0..1 along the scale */
+static float peak_pos[2];
+static int32_t peak_hold_ms[2];
+static uint32_t last_tick;
+static bool at_rest = true; /* everything drawn at zero and nothing arriving */
+
+static bool is_arc(const lv_obj_t * obj) { return lv_obj_has_class(obj, &lv_arc_class); }
+
+static lv_obj_t * find_meter(lv_obj_t * scr, const char * role) {
+    lv_obj_t * obj = lv_obj_find_by_name(scr, role);
+    if (obj && !lv_obj_has_class(obj, &lv_bar_class) && !is_arc(obj)) {
+        fprintf(stderr, "Warning: player layout: '%s' is not a bar or an arc, ignoring it\n", role);
+        return NULL;
+    }
+    return obj;
+}
+
+static float scale_pos(float db) {
+    float pos = (db - FLOOR_DB) / -FLOOR_DB;
+    return pos < 0.0f ? 0.0f : pos > 1.0f ? 1.0f : pos;
+}
+
+static float band_scale_pos(float db) {
+    float pos = (db - BAND_FLOOR_DB) / (BAND_TOP_DB - BAND_FLOOR_DB);
+    return pos < 0.0f ? 0.0f : pos > 1.0f ? 1.0f : pos;
+}
+
+/* Holds a peak for PEAK_HOLD_MS, then lets it fall to whatever is under it. */
+static void step_peak(float * peak, int32_t * hold_ms, float target, uint32_t step_ms) {
+    if (target >= *peak) {
+        *peak = target;
+        *hold_ms = PEAK_HOLD_MS;
+    } else if (*hold_ms > 0) {
+        *hold_ms -= (int32_t) step_ms;
+    } else {
+        *peak -= PEAK_FALL_PER_MS * (float) step_ms;
+        if (*peak < target) *peak = target;
+    }
+}
+
+static void draw_level(int c) {
+    int32_t value = (int32_t) (level_pos[c] * METER_RANGE + 0.5f);
+    if (level_bar[c] && is_arc(level_bar[c])) lv_arc_set_value(level_bar[c], value);
+    else if (level_bar[c]) lv_bar_set_value(level_bar[c], value, LV_ANIM_OFF);
+
+    if (needle[c]) {
+        int32_t angle = (int32_t) ((level_pos[c] * 2.0f - 1.0f) * NEEDLE_HALF_SWING);
+        int32_t moved = angle - needle_drawn[c];
+        if (moved >= NEEDLE_STEP || moved <= -NEEDLE_STEP || (angle == -NEEDLE_HALF_SWING && moved)) {
+            needle_drawn[c] = angle;
+            lv_obj_set_style_transform_rotation(needle[c], angle, 0);
+        }
+    }
+}
+
+/* A peak on an arc is always a short mark: the stretch of the dial just
+ * below the held peak, and nothing at all at the empty end. */
+static void draw_peak_arc(lv_obj_t * arc, float pos) {
+    int32_t start = lv_arc_get_bg_angle_start(arc);
+    int32_t sweep = (lv_arc_get_bg_angle_end(arc) - start + 360) % 360;
+    if (sweep == 0) sweep = 360;
+    int32_t at = (int32_t) (pos * (float) sweep + 0.5f);
+    int32_t mark = sweep * PEAK_TICK_UNITS / METER_RANGE;
+    if (mark < 2) mark = 2;
+    bool shown = at > mark / 2;
+    lv_opa_t opa = shown ? LV_OPA_COVER : LV_OPA_TRANSP;
+    if (lv_obj_get_style_arc_opa(arc, LV_PART_INDICATOR) != opa)
+        lv_obj_set_style_arc_opa(arc, opa, LV_PART_INDICATOR);
+    if (shown) lv_arc_set_angles(arc, (lv_value_precise_t) (start + (at > mark ? at - mark : 0)),
+                                 (lv_value_precise_t) (start + at));
+}
+
+static void draw_peak_obj(lv_obj_t * obj, float pos, int32_t tick_units);
+
+static void draw_peak(int c) {
+    if (peak_bar[c]) draw_peak_obj(peak_bar[c], peak_pos[c], peak_is_tick[c] ? PEAK_TICK_UNITS : 0);
+}
+
+static void draw_band(int b) {
+    if (band_bar[b]) {
+        int32_t value = (int32_t) (band_pos[b] * METER_RANGE + 0.5f);
+        if (is_arc(band_bar[b])) lv_arc_set_value(band_bar[b], value);
+        else lv_bar_set_value(band_bar[b], value, LV_ANIM_OFF);
+    }
+    if (band_peak[b]) draw_peak_obj(band_peak[b], band_peak_pos[b], band_peak_is_tick[b] ? BAND_CAP_UNITS : 0);
+}
+
+/* tick_units is how long a mark to draw at pos, or 0 for a filled bar. */
+static void draw_peak_obj(lv_obj_t * obj, float pos, int32_t tick_units) {
+    if (is_arc(obj)) {
+        draw_peak_arc(obj, pos);
+        return;
+    }
+    int32_t value = (int32_t) (pos * METER_RANGE + 0.5f);
+    if (tick_units) {
+        /* Nothing at all at the empty end, rather than a tick parked there. */
+        int32_t start = value > tick_units ? value - tick_units : 0;
+        if (value <= tick_units / 2) start = value = 0;
+        lv_bar_set_start_value(obj, start, LV_ANIM_OFF);
+    }
+    lv_bar_set_value(obj, value, LV_ANIM_OFF);
+}
+
+/* What every bar and arc of the meter gets, whatever it shows. */
+static void adopt(lv_obj_t * obj, lv_style_t * accent_style) {
+    if (is_arc(obj)) {
+        lv_arc_set_range(obj, 0, METER_RANGE);
+        /* A dial is read, not turned: no knob. */
+        lv_obj_set_style_opa(obj, LV_OPA_TRANSP, LV_PART_KNOB);
+    } else {
+        lv_bar_set_range(obj, 0, METER_RANGE);
+    }
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_CLICKABLE);
+    if (accent_style) lv_obj_add_style(obj, accent_style, LV_PART_INDICATOR);
+}
+
+static bool is_tick(lv_obj_t * obj) {
+    return obj && !is_arc(obj) && lv_bar_get_mode(obj) == LV_BAR_MODE_RANGE;
+}
+
+void player_vu_meter_bind(lv_obj_t * scr, lv_style_t * rail_style, lv_style_t * arc_rail_style,
+                          lv_style_t * accent_style) {
+    static const char * const level_roles[2] = { "vu_left", "vu_right" };
+    static const char * const peak_roles[2] = { "vu_peak_left", "vu_peak_right" };
+    static const char * const needle_roles[2] = { "vu_needle_left", "vu_needle_right" };
+
+    player_vu_meter_reset();
+    for (int c = 0; c < 2; c++) {
+        level_bar[c] = find_meter(scr, level_roles[c]);
+        peak_bar[c] = find_meter(scr, peak_roles[c]);
+        needle[c] = lv_obj_find_by_name(scr, needle_roles[c]);
+        lv_obj_t * bars[2] = { level_bar[c], peak_bar[c] };
+        for (int i = 0; i < 2; i++)
+            if (bars[i]) adopt(bars[i], accent_style);
+        if (level_bar[c]) {
+            lv_style_t * rail = is_arc(level_bar[c]) ? arc_rail_style : rail_style;
+            if (rail) lv_obj_add_style(level_bar[c], rail, LV_PART_MAIN);
+        }
+        if (needle[c]) {
+            lv_obj_remove_flag(needle[c], LV_OBJ_FLAG_CLICKABLE);
+            needle_drawn[c] = -NEEDLE_HALF_SWING;
+            lv_obj_set_style_transform_rotation(needle[c], -NEEDLE_HALF_SWING, 0);
+        }
+        peak_is_tick[c] = is_tick(peak_bar[c]);
+        draw_level(c);
+        draw_peak(c);
+    }
+    for (int b = 0; b < LEVEL_METER_BANDS; b++) {
+        char role[24];
+        lv_snprintf(role, sizeof(role), "vu_band_%d", b + 1);
+        band_bar[b] = find_meter(scr, role);
+        lv_snprintf(role, sizeof(role), "vu_band_peak_%d", b + 1);
+        band_peak[b] = find_meter(scr, role);
+        if (band_bar[b]) {
+            adopt(band_bar[b], accent_style);
+            lv_style_t * rail = is_arc(band_bar[b]) ? arc_rail_style : rail_style;
+            if (rail) lv_obj_add_style(band_bar[b], rail, LV_PART_MAIN);
+        }
+        if (band_peak[b]) adopt(band_peak[b], accent_style);
+        band_peak_is_tick[b] = is_tick(band_peak[b]);
+        if (band_bar[b] || band_peak[b]) have_bands = true;
+        draw_band(b);
+    }
+    last_tick = lv_tick_get();
+}
+
+void player_vu_meter_reset(void) {
+    memset(level_bar, 0, sizeof(level_bar));
+    memset(peak_bar, 0, sizeof(peak_bar));
+    memset(needle, 0, sizeof(needle));
+    memset(peak_is_tick, 0, sizeof(peak_is_tick));
+    memset(level_pos, 0, sizeof(level_pos));
+    memset(peak_pos, 0, sizeof(peak_pos));
+    memset(peak_hold_ms, 0, sizeof(peak_hold_ms));
+    memset(band_bar, 0, sizeof(band_bar));
+    memset(band_peak, 0, sizeof(band_peak));
+    memset(band_peak_is_tick, 0, sizeof(band_peak_is_tick));
+    memset(band_pos, 0, sizeof(band_pos));
+    memset(band_peak_pos, 0, sizeof(band_peak_pos));
+    memset(band_hold_ms, 0, sizeof(band_hold_ms));
+    have_bands = false;
+    at_rest = true;
+}
+
+bool player_vu_meter_present(void) {
+    return level_bar[0] || level_bar[1] || peak_bar[0] || peak_bar[1] || needle[0] || needle[1] || have_bands;
+}
+
+void player_vu_meter_tick(void) {
+    if (!player_vu_meter_present()) return;
+
+    level_meter_request(have_bands);
+    level_meter_levels_t levels;
+    bool sounding = level_meter_read(&levels);
+
+    uint32_t now = lv_tick_get();
+    uint32_t step_ms = now - last_tick;
+    last_tick = now;
+    if (at_rest && !sounding) return; /* paused or stopped, and already drawn empty */
+    if (step_ms > MAX_STEP_MS) step_ms = MAX_STEP_MS;
+
+    float rise = 1.0f - expf(-(float) step_ms / RISE_TAU_MS);
+    float fall = 1.0f - expf(-(float) step_ms / FALL_TAU_MS);
+    bool resting = !sounding;
+    for (int c = 0; c < 2; c++) {
+        float level_target = 0.0f, peak_target = 0.0f;
+        if (sounding) {
+            if (levels.mean_square[c] > 0.0f)
+                level_target = scale_pos(10.0f * log10f(levels.mean_square[c]) + RMS_OFFSET_DB);
+            if (levels.peak[c] > 0.0f) peak_target = scale_pos(20.0f * log10f(levels.peak[c]));
+        }
+
+        level_pos[c] += (level_target - level_pos[c]) * (level_target > level_pos[c] ? rise : fall);
+        if (level_pos[c] < 0.0005f) level_pos[c] = 0.0f;
+
+        step_peak(&peak_pos[c], &peak_hold_ms[c], peak_target, step_ms);
+
+        draw_level(c);
+        draw_peak(c);
+        if (level_pos[c] > 0.0f || peak_pos[c] > 0.0f) resting = false;
+    }
+    if (have_bands) {
+        float band_rise = 1.0f - expf(-(float) step_ms / BAND_RISE_TAU_MS);
+        float band_fall = 1.0f - expf(-(float) step_ms / BAND_FALL_TAU_MS);
+        for (int b = 0; b < LEVEL_METER_BANDS; b++) {
+            if (!band_bar[b] && !band_peak[b]) continue;
+            float target = 0.0f;
+            if (sounding && levels.band_mean_square[b] > 0.0f)
+                target = band_scale_pos(10.0f * log10f(levels.band_mean_square[b]) + RMS_OFFSET_DB);
+            band_pos[b] += (target - band_pos[b]) * (target > band_pos[b] ? band_rise : band_fall);
+            if (band_pos[b] < 0.0005f) band_pos[b] = 0.0f;
+            /* The cap rides the bar itself, not the raw level: it marks where
+             * the bar has been. */
+            step_peak(&band_peak_pos[b], &band_hold_ms[b], band_pos[b], step_ms);
+            draw_band(b);
+            if (band_pos[b] > 0.0f || band_peak_pos[b] > 0.0f) resting = false;
+        }
+    }
+    at_rest = resting;
+}
diff --git a/src/ui/player/meter/player_vu_meter.h b/src/ui/player/meter/player_vu_meter.h
new file mode 100644

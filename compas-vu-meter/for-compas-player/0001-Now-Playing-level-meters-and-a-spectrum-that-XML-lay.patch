@@ -0,0 +1,67 @@
+#ifndef PLAYER_VU_METER_H
+#define PLAYER_VU_METER_H
+
+#include "lvgl/lvgl.h"
+#include <stdbool.h>
+
+/* Level meter for Now Playing layouts.
+ *
+ * A layout opts in by naming widgets:
+ *
+ *   vu_left, vu_right              the level, with VU-like ballistics;
+ *                                  an lv_bar (or lv_slider), or an lv_arc
+ *                                  for a round dial
+ *   vu_peak_left, vu_peak_right    the peak, held for a moment, then
+ *                                  falling; an lv_bar or an lv_arc
+ *   vu_needle_left, vu_needle_right  any object, turned about its transform
+ *                                  pivot with the level: 45 degrees left of
+ *                                  upright when empty, 45 right when full,
+ *                                  which is the fan of an arc from 225 to
+ *                                  315 degrees
+ *
+ *   vu_band_1 ... vu_band_10       a spectrum: the level of the mono mix in
+ *                                  ten bands an octave apart, 31 Hz to
+ *                                  16 kHz; an lv_bar or an lv_arc each
+ *   vu_band_peak_1 ... _10         a cap that rides each band's bar, held
+ *                                  and then falling
+ *
+ * All are optional and independent; a layout with only vu_left gets a
+ * mono-looking meter of the left channel. The player owns each bar's range
+ * and value. The spectrum is only measured for a layout that names a band,
+ * and its scale runs from -54 dB to full scale, a band being a fraction of the
+ * whole. The level's scale is linear in decibels from -48 dB at the empty end to
+ * full scale at the other; the level is RMS, read so that a full-scale sine
+ * fills the bar. A peak bar declared with mode="range" is drawn as a short
+ * tick at the held peak instead of a filled bar, so it can sit on top of a
+ * level bar as a peak-hold mark. A peak arc is always drawn as such a mark.
+ *
+ * A layout may wrap its meter in an object named vu_meter; the bars are found
+ * inside it all the same, and the whole group, captions included, is then
+ * hidden with the transport controls while the lyrics are open. Without the
+ * group only the bars and arcs are, so a layout with needles wants the group.
+ *
+ * The group can also be swiped sideways: it names a plugin action for each
+ * direction in a hidden label inside it, vu_swipe_left and vu_swipe_right
+ * (gui_player.c binds this; the meter itself does not know about it).
+ *
+ * The bars and arcs take the theme accent on their indicator and, when given,
+ * the backdrop rail style on the level's track; local XML style properties
+ * outrank both. An arc's knob is hidden. Everything is made non-clickable so
+ * swipes pass through. */
+
+/* Finds the roles under scr. The two rail styles (for bars and for arcs) may
+ * be NULL. Safe to call again for a new tree after player_vu_meter_reset(). */
+void player_vu_meter_bind(lv_obj_t * scr, lv_style_t * rail_style, lv_style_t * arc_rail_style,
+                          lv_style_t * accent_style);
+
+/* Forgets the widgets (they belong to a tree that is going away). */
+void player_vu_meter_reset(void);
+
+/* True when the bound layout has at least one meter widget. */
+bool player_vu_meter_present(void);
+
+/* Advances the meter; call on the player UI tick while the Now Playing
+ * screen is the one being drawn. Not calling it lets the audio tap go idle. */
+void player_vu_meter_tick(void);
+
+#endif

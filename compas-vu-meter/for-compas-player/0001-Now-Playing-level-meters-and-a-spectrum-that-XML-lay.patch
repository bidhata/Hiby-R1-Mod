+static lv_obj_t * player_vu_swipe_zone;
+
+static void player_vu_swipe_cb(lv_event_t * e) {
+    if (lv_event_get_code(e) != LV_EVENT_GESTURE) return;
+    lv_indev_t * indev = lv_event_get_indev(e);

+    lv_obj_t * group = lv_event_get_current_target(e);
+    lv_obj_t * name = lv_obj_find_by_name(group, dir == LV_DIR_LEFT ? "vu_swipe_left" : "vu_swipe_right");
+    if (!name || !lv_obj_check_type(name, &lv_label_class)) return;

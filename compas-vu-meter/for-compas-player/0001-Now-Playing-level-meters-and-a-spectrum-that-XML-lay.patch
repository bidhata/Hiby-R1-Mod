+}
+
+static void player_bind_vu_swipe(lv_obj_t * scr) {
+    lv_obj_t * group = lv_obj_find_by_name(scr, "vu_meter");
+    if (!group || player_layout_builtin) return;
+    if (!lv_obj_find_by_name(group, "vu_swipe_left") && !lv_obj_find_by_name(group, "vu_swipe_right")) return;
+    lv_obj_add_flag(group, LV_OBJ_FLAG_CLICKABLE); /* or the press never reaches it */
+    lv_obj_add_event_cb(group, player_vu_swipe_cb, LV_EVENT_GESTURE, NULL);
+    register_swipe_dead_zone(group);
+    player_vu_swipe_zone = group;
+}
+
 static bool player_obj_is_ancestor_of(const lv_obj_t * ancestor, const lv_obj_t * obj) {
     for (const lv_obj_t * p = obj ? lv_obj_get_parent(obj) : NULL; p; p = lv_obj_get_parent(p)) {
         if (p == ancestor) return true;
@@ -1058,6 +1092,14 @@ static void player_bind_lyrics_pane(lv_obj_t * scr, const player_roles_t * r, pl
                                 player_obj_is_ancestor_of(kept[k], controls[i]))) hide = false;
             if (hide) player_add_lyrics_control(controls[i]);
         }
+        /* The level meter leaves with the controls: as one group when the
+         * layout wraps it in "vu_meter" (so its captions go too), bar by bar
+         * otherwise. */
+        lv_obj_t * meter_group = player_find_role(scr, "vu_meter", NULL);

            <lv_label name="caption_vu_right" text="R" x="30" y="24" width="18" height="content" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
            <lv_bar name="vu_right" x="56" y="30" width="394" height="8" style_radius="4" style_radius:indicator="4" style_border_width="0" style_pad_all="0" />

        <lv_label name="artist" text="" x="22" y="83" width="436" height="content" style_text_font="player_meta" style_text_align="center" style_pad_all="0" />
        <lv_label name="album" text="" x="22" y="117" width="436" height="content" style_text_font="player_meta" style_text_align="center" style_pad_all="0" />

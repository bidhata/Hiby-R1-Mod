<component>
    <view extends="lv_obj" width="#screen_w" height="#screen_h" scrollable="false" style_bg_opa="0" style_border_width="0" style_radius="0" style_pad_all="0">
        <lv_obj name="overlay_panel" x="0" y="0" width="#screen_w" height="#screen_h" scrollable="false" style_bg_opa="0" style_border_width="0" style_radius="0" style_pad_all="0" clickable="false">
            <lv_image name="background_img" x="0" y="0" width="#screen_w" height="#screen_h" />
        </lv_obj>
        <lv_obj name="cover_card" x="100" y="137" width="280" height="280" scrollable="false" style_radius="9" style_clip_corner="true" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="cover_img" src="default_cover" align="center" />
            <lv_label name="song_count" text="" x="9" y="9" width="content" height="content" style_text_font="font_16" style_bg_opa="128" style_radius="100" style_pad_hor="9" style_pad_ver="5" />
            <lv_obj name="favorite_circle" x="231" y="231" width="40" height="40" scrollable="false" style_radius="100" style_bg_opa="102" style_border_width="0" style_pad_all="0">
                <lv_image name="favorite_icon" src="collect_out" width="32" height="32" align="center" inner_align="contain" />
            </lv_obj>
        </lv_obj>
        <lv_obj name="dismiss_btn" x="22" y="56" width="40" height="40" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" />
        <lv_label name="title" text="" x="22" y="32" width="436" height="content" style_text_font="player_title" style_text_align="center" style_pad_all="0" />
        <lv_label name="artist" text="" x="22" y="68" width="436" height="content" style_text_font="player_meta" style_text_align="center" style_pad_all="0" />
        <lv_label name="album" text="" x="22" y="97" width="436" height="content" style_text_font="player_meta" style_text_align="center" style_pad_all="0" />
        <lv_obj name="quality_pill" x="0" y="428" width="content" height="content" scrollable="false" style_radius="100" style_bg_opa="51" style_border_width="0" style_pad_all="0" clickable="false" align="top_mid" style_min_height="32" style_bg_color="0x000000" flex_flow="row" style_flex_main_place="center" style_flex_cross_place="center" style_flex_track_place="center" style_pad_hor="13" style_pad_ver="5" style_pad_column="9">
            <lv_image src="quality_waveform" width="20" height="20" inner_align="contain" name="quality_icon" />
            <lv_label name="format_badge" text="" width="content" height="content" style_text_font="font_16" style_text_align="center" long_mode="clip" style_pad_all="0" />
        </lv_obj>
        <lv_obj name="vu_meter" x="0" y="466" width="#screen_w" height="44" scrollable="false" style_bg_opa="0" style_border_width="0" style_radius="0" style_pad_all="0" clickable="true">
            <event_cb trigger="clicked" callback="compas_action" user_data="vu_to_dial" />
            <lv_label name="vu_swipe_left" text="vu_to_dial" hidden="true" />
            <lv_label name="vu_swipe_right" text="vu_to_spectrum" hidden="true" />
            <lv_label name="caption_vu_left" text="L" x="30" y="2" width="18" height="content" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
            <lv_bar name="vu_left" x="56" y="8" width="394" height="8" style_radius="4" style_radius:indicator="4" style_border_width="0" style_pad_all="0" />
            <lv_bar name="vu_peak_left" mode="range" x="56" y="8" width="394" height="8" style_radius="4" style_radius:indicator="4" style_border_width="0" style_pad_all="0" style_bg_opa="0" />
            <lv_label name="caption_vu_right" text="R" x="30" y="22" width="18" height="content" style_text_font="font_16" style_text_align="left" style_pad_all="0" />
            <lv_bar name="vu_right" x="56" y="28" width="394" height="8" style_radius="4" style_radius:indicator="4" style_border_width="0" style_pad_all="0" />
            <lv_bar name="vu_peak_right" mode="range" x="56" y="28" width="394" height="8" style_radius="4" style_radius:indicator="4" style_border_width="0" style_pad_all="0" style_bg_opa="0" />
        </lv_obj>
        <lv_slider name="progress_slider" x="30" y="522" width="420" height="14" style_radius="7" />
        <lv_label name="pos_label" text="0:00" x="30" y="560" width="120" height="24" style_text_font="player_meta" style_text_align="left" style_pad_all="0" />
        <lv_label name="dur_label" text="--:--" x="330" y="560" width="120" height="24" style_text_font="player_meta" style_text_align="right" style_pad_all="0" />
        <lv_image name="order_btn" src="order" x="39" y="612" width="36" height="36" inner_align="contain" />
        <lv_image name="prev_btn" src="btn_prev" x="124" y="612" width="36" height="36" inner_align="contain" />
        <lv_obj name="play_circle" x="202" y="592" width="76" height="76" scrollable="false" style_bg_opa="0" style_border_width="0" style_pad_all="0" clickable="false">
            <lv_image name="play_btn" src="btn_play" x="0" y="0" width="76" height="76" inner_align="contain" />
        </lv_obj>
        <lv_image name="next_btn" src="btn_next" x="320" y="612" width="36" height="36" inner_align="contain" />
        <lv_image name="more_btn" src="ic_more" x="405" y="612" width="36" height="36" inner_align="contain" />
        <lv_slider name="volume_slider" width="100" height="10" hidden="true" />
    </view>
</component>
